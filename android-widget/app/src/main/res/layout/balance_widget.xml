<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#172554">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MEU DINDIN" android:textColor="#BFDBFE" android:textStyle="bold" android:textSize="12sp"/>
    <TextView android:id="@+id/widget_balance" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="R$ 0,00" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="25sp" android:paddingTop="4dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp">
        <TextView android:id="@+id/widget_income" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Entradas  R$ 0,00" android:textColor="#86EFAC" android:textSize="12sp"/>
        <TextView android:id="@+id/widget_expense" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Saídas  R$ 0,00" android:textColor="#FCA5A5" android:textSize="12sp"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Toque para atualizar" android:textColor="#CBD5E1" android:textSize="10sp" android:paddingTop="5dp"/>
</LinearLayout>
